{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The live Worker on the Cloudflare account (it holds sandeshrimal.com.np and www). Deploying under
  // this name replaces the site; a different name would create a second, empty Worker.
  "name": "personal-portfolio",
  "compatibility_date": "2025-09-24",
  // Static site: no Worker code, just the exported files.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
